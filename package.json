{
  "name": "machine-stats",
  "displayName": "机器负载",
  "description": "CPU、内存、磁盘、网络与温度读数",
  "icon": { "symbol": "cpu", "color": "green" },
  "version": "2.1.0",
  "categories": ["机器与资源"],
  "contributes": {
    "protocolImplementations": ["coda/resource@1"],
    "records": [{ "kind": "coda/resource@1", "command": "scripts/resource.mjs" }]
  },
  "dependencies": {
    "systeminformation": "5.33.15"
  },
  "devDependencies": {
    "@coda-console/protocol": "6.23.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "coda": 6
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/machine-stats.git"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "sample": "node scripts/resource.mjs"
  },
  "files": [
    "scripts"
  ]
}
