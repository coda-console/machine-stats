{
  "name": "machine-stats",
  "displayName": "机器负载",
  "description": "CPU、内存、磁盘、网络与温度读数",
  "icon": { "symbol": "cpu", "color": "green" },
  "version": "2.0.0",
  "categories": ["机器与资源"],
  "contributes": {
    "resources": [
      {
        "id": "cpu",
        "title": "CPU",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/stats.mjs\" cpu"
      },
      {
        "id": "memory",
        "title": "内存",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/stats.mjs\" memory"
      },
      {
        "id": "swap",
        "title": "交换空间",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/stats.mjs\" swap",
        "hidden": true
      },
      {
        "id": "disks",
        "title": "磁盘",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/stats.mjs\" disks"
      },
      {
        "id": "disk-io",
        "title": "磁盘读写",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/stats.mjs\" disk-io",
        "hidden": true
      },
      {
        "id": "network",
        "title": "网络",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/stats.mjs\" network"
      },
      {
        "id": "temperature",
        "title": "温度",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/stats.mjs\" temperature"
      },
      {
        "id": "gpu",
        "title": "GPU",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/stats.mjs\" gpu",
        "hidden": true
      },
      {
        "id": "battery",
        "title": "电池",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/stats.mjs\" battery",
        "hidden": true
      },
      {
        "id": "fans",
        "title": "风扇",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/stats.mjs\" fans",
        "hidden": true
      }
    ]
  },
  "dependencies": {
    "systeminformation": "5.33.15"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/machine-stats.git"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "sample": "node scripts/stats.mjs --all"
  },
  "files": [
    "scripts"
  ]
}
